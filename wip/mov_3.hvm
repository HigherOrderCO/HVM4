// GOAL: uncomment @name_mov and ensure it runs under 50k interactions

@O = λp. λo. λi. λe. o(p)
@I = λp. λo. λi. λe. i(p)
@E =     λo. λi. λe. e

@bin = λ{
  0n: λn. λo. λi. λe. e;
  1n+: λ&l. λ&n. (λ{
    0: λo. λi. λe. o(@bin(l, n/2))
    1: λo. λi. λe. i(@bin(l, n/2))
  })(n % 2)
}

@rep = λxs.
  ! O = λp. λ&f. λx. @rep(p, λk. f(f(k)), x)
  ! I = λp. λ&f. λx. @rep(p, λk. f(f(k)), f(x))
  ! E = λf. λx. x
  xs(O, I, E)

@view = λxs.
  ! O = λp. #O{@view(p)}
  ! I = λp. #I{@view(p)}
  ! E = #E
  xs(O, I, E)

@ones_dup = λx. λo. λ&i. λe.
  x(λp.i(@ones_dup(p)), λp.i(@ones_dup(p)), e)

//@ones_mov = λx. λo. λi. λe.
//  % f = i
//  x(λp.f(@ones_mov(p)), λp.f(@ones_mov(p)), e)

@ones_lam = λx. λo. λi. λe.
  x(λp.λi.i(@ones_lam(p)), λp.λi.i(@ones_lam(p)), λi.e, i)

@main = @view(@rep(@bin(32n,1030), @ones_lam, @bin(32n,0)))
