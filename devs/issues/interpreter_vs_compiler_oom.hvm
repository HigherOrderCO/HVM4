// Minimal repro for the native compiler/equality blow-up.
//
// The same closed lower-order term and same input are used by both mains:
//
//   A 3 1 == 0
//
// `@main_eval` evaluates through the lower-order interpreter, normalizes both
// sides, and returns 1 via native `===`.
// `@main_compile` compiles the same term to native HVM and OOMs / times out.
//
// Switch the final `@main` between the two aliases below.

@Y = λ&f. f(@Y(f))

@nat = λ{ 0: #Tup{#Bt0, #One}; λn. #Tup{#Bt1, @nat(n - 1)} }

// A : Nat -> Nat -> Nat
//
// Agda-ish shape:
//
//   A zero      y       = y
//   A (suc x)   zero    = x
//   A (suc x)  (suc y)  = A x (A (suc x) y)
//
// This term is generated by the bad normal-`x:A` search variant.
@A = #Fix{#Get{#Mat{
  #Use{#Lam{#Var{0}}},
  #Lam{#Get{#Mat{
    #Use{#Var{0}},
    #Lam{#App{
      #App{#Var{2}, #Var{1}},
      #App{#App{#Var{2}, #Tup{#Bt1, #Var{1}}}, #Var{0}}
    }}
  }}}
}}}

@term     = #App{#App{@A, @nat(3)}, @nat(1)}
@expected = @nat(0)

// Lower-order evaluator
// ---------------------

@wnf = λ{
  #Var: λidx. λenv.
    @wnf_clo(@env_get(idx, env));
  #Lam: λbody. λenv.
    #Lam{#Clo{env, body}};
  #App: λfun. λarg. λ&env.
    @wnf_app(@wnf(fun, env), #Clo{env, arg});
  #Fix: λbody. λenv.
    @wnf_fix(body, env);
  #One: λenv.
    #One;
  #Bt0: λenv.
    #Bt0;
  #Bt1: λenv.
    #Bt1;
  #Use: λbody. λenv.
    #Use{#Clo{env, body}};
  #Mat: λzero. λone. λ&env.
    #Mat{#Clo{env, zero}, #Clo{env, one}};
  #Get: λbody. λenv.
    #Get{#Clo{env, body}};
  #Tup: λfst. λsnd. λ&env.
    #Tup{#Clo{env, fst}, #Clo{env, snd}};
}

@wnf_clo = λ{
  #Clo: λenv. λterm.
    @wnf_clo(@wnf(term, env));
  λval.
    val;
}

@wnf_fix = λ&body. λ&env.
  ! self = #Clo{env, #Fix{body}}
  @wnf(body, #Con{self, env})

@wnf_app = λ{
  #Clo: λenv. λterm. λarg.
    @wnf_app(@wnf(term, env), arg);
  #Lam: λbody. λarg.
    @clo_open(body, @wnf_clo(arg));
  #Use: λbody. λarg.
    @wnf_app_use(@wnf_clo(arg), body);
  #Mat: λzero. λone. λarg.
    @wnf_app_mat(@wnf_clo(arg), zero, one);
  #Get: λbody. λarg.
    @wnf_app_get(@wnf_clo(arg), body);
}

@wnf_app_use = λ{
  #One: λbody.
    @wnf_clo(body);
}

@wnf_app_mat = λ{
  #Bt0: λzero. λone.
    @wnf_clo(zero);
  #Bt1: λzero. λone.
    @wnf_clo(one);
}

@wnf_app_get = λ{
  #Tup: λfst. λsnd. λbody.
    @wnf_app(@wnf_app(@wnf_clo(body), fst), snd);
}

@env_get = λ{
  0: λ{
    #Con: λval. λenv.
      val;
  };
  λidx. λ{
    #Con: λval. λenv.
      @env_get(idx - 1, env);
  }
}

@clo_open = λ{
  #Clo: λenv. λbody. λval.
    @wnf(body, #Con{val, env});
}

@snf = λterm.
  @snf_go(@wnf(term, #Nil))

@snf_go = λ{
  #Clo: λenv. λterm.
    @snf_go(@wnf(term, env));
  #One:
    #One;
  #Bt0:
    #Bt0;
  #Bt1:
    #Bt1;
  #Tup: λfst. λsnd.
    #Tup{@snf_go(fst), @snf_go(snd)};
}

// Native compiler
// ---------------

@compile = λterm.
  ! &Tup{ctx, val} = @higher(term, [])
  val

@higher = λ{
  #Var: λidx. λctx.
    @higher_var(idx, ctx);
  #Lam: λ&body. λctx.
    ! fun = λx ;
    ! &Tup{ctx0, val} = @higher(body, #Val{@uses(0, body), x} <> ctx)
    ! &Tup{ctx1, bind} = @higher_pop(ctx0)
    &Tup{ctx1, #Fun{fun(val)}};
  #App: λfun. λarg. λctx.
    ! &Tup{ctx0, fun} = @higher(fun, ctx)
    ! &Tup{ctx1, arg} = @higher(arg, ctx0)
    &Tup{ctx1, @higher_apply(fun, arg)};
  #Fix: λ&body. λctx.
    ! fun = λx ;
    ! &Tup{ctx0, val} = @higher(body, #Val{@uses(0, body), x} <> ctx)
    ! &Tup{ctx1, bind} = @higher_pop(ctx0)
    &Tup{ctx1, @Y(fun(val))};
  #One: λctx.
    &Tup{ctx, #One};
  #Bt0: λctx.
    &Tup{ctx, #Bt0};
  #Bt1: λctx.
    &Tup{ctx, #Bt1};
  #Use: λbody. λctx.
    ! &Tup{ctx0, body} = @higher(body, ctx)
    &Tup{ctx0, #Fun{λ{ #One: body }}};
  #Mat: λzero. λone. λctx.
    ! &Tup{ctx0, zero} = @higher(zero, ctx)
    ! &Tup{ctx1, one} = @higher(one, ctx0)
    &Tup{ctx1, #Fun{λ{ #Bt0: zero; #Bt1: one }}};
  #Get: λbody. λctx.
    ! &Tup{ctx0, body} = @higher(body, ctx)
    &Tup{ctx0, #Fun{λ{
      #Tup: λfst. λsnd.
        @higher_apply(@higher_apply(body, fst), snd);
    }}};
  #Tup: λfst. λsnd. λctx.
    ! &Tup{ctx0, fst} = @higher(fst, ctx)
    ! &Tup{ctx1, snd} = @higher(snd, ctx0)
    &Tup{ctx1, #Tup{fst, snd}};
}

@higher_apply = λ{
  #Fun: λcall. λarg.
    call(arg);
}

@higher_pop = λ{
  <>: λval. λctx.
    &Tup{ctx, val};
}

@uses = λ&I. λ{
  #Var: λidx.
    I == idx;
  #Lam: λbody.
    @uses(I + 1, body);
  #App: λfun. λarg.
    @uses(I, fun) + @uses(I, arg);
  #Fix: λbody.
    @uses(I + 1, body);
  #One:
    0;
  #Bt0:
    0;
  #Bt1:
    0;
  #Use: λbody.
    @uses(I, body);
  #Mat: λzero. λone.
    @uses(I, zero) + @uses(I, one);
  #Get: λbody.
    @uses(I, body);
  #Tup: λfst. λsnd.
    @uses(I, fst) + @uses(I, snd);
}

@higher_var = λ{
  0: λ{
    <>: λ{
      #Val: λcount. λval. λctx.
        @higher_use(count, val, ctx);
    };
    []:
      &Tup{[], &{}};
  };
  λidx. λ{
    <>: λ{
      #Val: λcount. λval. λctx.
        ! &Tup{ctx0, got} = @higher_var(idx - 1, ctx)
        &Tup{#Val{count, val} <> ctx0, got};
    };
    []:
      &Tup{[], &{}};
  }
}

@higher_use = λ{
  0: λval. λctx.
    &Tup{#Val{0, &{}} <> ctx, &{}};
  1: λval. λctx.
    &Tup{#Val{0, &{}} <> ctx, val};
  λcount. λval. λctx.
    ! copy & = val
    &Tup{#Val{count - 1, copy₀} <> ctx, copy₁};
}

@main_eval = @snf(@term) === @expected
@main_comp = @compile(@term) === @compile(@expected)

@main = @main_comp
